TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
BOT_DB=/app/data/bot.sqlite3
LOG_LEVEL=INFO
DIGEST_LIMIT=30
DIGEST_PAGE_SIZE=10
FETCH_TIMEOUT_SECONDS=20
DEFAULT_DIGEST_DAYS=3
FREE_SOURCE_LIMIT=20
STARS_PER_EXTRA_SOURCE=10
PAID_SLOT_DAYS=30
# AI summaries (Google Gemini — https://aistudio.google.com/apikey)
AI_SUMMARY_ENABLED=1
AI_PROVIDER=gemini
# GEMINI_API_KEY=...
AI_MODEL=gemini-2.0-flash
AI_MAX_CONCURRENT=4
AI_TIMEOUT_SECONDS=15
