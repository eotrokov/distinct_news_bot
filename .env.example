TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
BOT_DB=data/bot.sqlite3
LOG_LEVEL=INFO
DIGEST_LIMIT=30
FETCH_TIMEOUT_SECONDS=20
DEFAULT_LOOKBACK_HOURS=24
# Optional: RSSHub instance for Facebook / Twitter without direct RSS URLs
# RSSHUB_BASE_URL=https://rsshub.app
# Optional: user MTProto API to resolve https://t.me/addlist/... folders
# Get at https://my.telegram.org → API development tools, then /tg_login in the bot
# TELEGRAM_API_ID=12345
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_SESSION_PATH=data/telethon.session
