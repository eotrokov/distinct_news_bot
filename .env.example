TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
BOT_DB=data/bot.sqlite3
LOG_LEVEL=INFO
DIGEST_LIMIT=30
DIGEST_PAGE_SIZE=10
FETCH_TIMEOUT_SECONDS=20
DEFAULT_DIGEST_DAYS=3
FREE_SOURCE_LIMIT=20
STARS_PER_EXTRA_SOURCE=10
PAID_SLOT_DAYS=30
SUMMARY_MAX_SENTENCES=3
WEEKLY_TOP_LIMIT=10
WEEKLY_DIGEST_HOUR_UTC=9
WEEKLY_DIGEST_WEEKDAY=0
# AI summaries (Groq free tier — https://console.groq.com)
AI_SUMMARY_ENABLED=1
# GROQ_API_KEY=gsk_...
AI_MODEL=llama-3.3-70b-versatile
AI_MAX_CONCURRENT=4
AI_TIMEOUT_SECONDS=15
