TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
BOT_DB=data/bot.sqlite3
LOG_LEVEL=INFO
DIGEST_LIMIT=30
DIGEST_PAGE_SIZE=10
FETCH_TIMEOUT_SECONDS=20
FETCH_CONCURRENCY=5
FETCH_CACHE_TTL_SECONDS=120
DEFAULT_LOOKBACK_HOURS=24
DEFAULT_DIGEST_DAYS=1
SUMMARY_MAX_SENTENCES=2
# Comma-separated Telegram user ids for /grant and /stats
# ADMIN_USER_IDS=123456789
# Web dashboard (docker compose service: dashboard)
# DASHBOARD_PORT=8080
# Monetization (Stars / plan limits). Off while paused; set to 1 to re-enable.
MONETIZATION_ENABLED=0
PRO_STARS_PRICE=350
PLUS_STARS_PRICE=700
# Optional AI summaries (Gemini Flash by default; rule-based fallback without key)
# AI_SUMMARY_ENABLED=1
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_MODEL=gemini-2.0-flash
# AI_MAX_CONCURRENT=4
# AI_TIMEOUT_SECONDS=15
# AI_PROVIDER=groq
# GROQ_API_KEY=
